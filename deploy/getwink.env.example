# Template for /etc/getwink/getwink.env on the server (chmod 600, root-owned).
# Fill with the real values out-of-band. NEVER commit the populated file.
#
# NEXT_PUBLIC_* are ALSO needed at image build time (GH Action build args), so
# keep them in sync with the CI secrets. Everything else is runtime-only and is
# never baked into the client bundle.

# --- Public (baked into client bundle at build) ---
NEXT_PUBLIC_SUPABASE_URL=<configured>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<configured>
NEXT_PUBLIC_ANDROID_APK_URL=<configured>   # https://www.getwink.app/download/beta.apk once live

# --- Server-only secrets (runtime, never in client bundle) ---
SUPABASE_URL=<configured>
SUPABASE_ANON_KEY=<configured>
SUPABASE_ROLE_KEY=<configured>
LANGDOCK_API_CODE=<configured>
LANGDOCK_ENDPOINT_URL=<configured>
MODEL=<configured>
